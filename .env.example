# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (public) key, or the "publishable" key on newer projects. Safe for the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only add this if a server task truly needs it. NEVER prefix with NEXT_PUBLIC_ and never import it in client code.
# The app is designed to work without it (issue_invoice and delete_account are database functions).
# SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in is configured in the Supabase dashboard (Authentication > Providers > Google),
# not in this file. Add the Google client ID and secret there.
